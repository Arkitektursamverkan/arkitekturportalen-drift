# Arkitekturportalen – installationens inställningar.
# Installationsguiden skriver den här filen; vill du göra det för hand:
#   cp .env.example .env  och fyll i. Varje hemlighet:  openssl rand -hex 32
# Filen innehåller hemligheter – chmod 600 .env och ta med den i backupen.

# ── Versioner och avbilder ────────────────────────────────────────────────────
PORTAL_VERSION=0.6.0
PLATFORM_VERSION=0.2.3
# Varifrån avbilderna hämtas.
# REGISTRY=ghcr.io/arkitektursamverkan

# ── Webbadress och TLS ────────────────────────────────────────────────────────
# Portalens värdnamn, utan https://. DNS ska peka på servern.
PORTAL_HOST=arkitektur.example.org
# auto (Let's Encrypt) | egen (certifikat i certs/) | intern (Caddys egen CA).
# Se caddy/Caddyfile.
TLS_MODE=auto
# Krävs för auto.
ACME_EMAIL=
# För egen: filnamnen i certs/ (certifikatet med hela kedjan, och nyckeln).
# TLS_CERT_FILE=fullchain.pem
# TLS_KEY_FILE=privkey.pem
# HTTP_PORT=80
# HTTPS_PORT=443

# ── Portalens hemligheter ─────────────────────────────────────────────────────
# Fungerar som administratör – för skript och integrationer, aldrig webbläsaren.
API_KEY=
# Signerar inloggningen för lokala konton (utan Entra ID).
LOCAL_AUTH_SECRET=
# Databasens lösenord. Läses bara när databasen skapas första gången.
POSTGRES_PASSWORD=

# ── Inloggning med Microsoft Entra ID (valfritt) ──────────────────────────────
# Tomt = bara lokala konton. SPA-appregistreringen behöver redirect-URI
# https://<PORTAL_HOST>/ och ett exponerat API-scope access_as_user.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Standard: api://<ENTRA_CLIENT_ID>/access_as_user
ENTRA_API_SCOPE=
# Bara dessa e-postdomäner får logga in (kommaseparerade).
ALLOWED_EMAIL_DOMAINS=example.org
# Den som loggar in med en av dessa blir administratör.
BOOTSTRAP_ADMIN_EMAILS=

# ── Organisation och moduler ─────────────────────────────────────────────────
# Standardvärden: en administratör ändrar dem under Administration → Organisation.
PDF_ORG_NAME=
# Valfria moduler, kommaseparerade, eller "all". Tomt = bara kärnan.
#   calendar  collaboration  governance  glossary  surveys  changes
MODULES=
# Får man läsa arkitekturobjekten utan att logga in?
ANONYMOUS_READ=false
# Avdelningar (som Entra ID namnger dem) som skriver i förändringsloggen.
CHANGE_LOG_DEPARTMENTS=
LOG_LEVEL=info

# ── Backup ────────────────────────────────────────────────────────────────────
# Så många backuper (backup.sh) sparas i backups/; de äldsta tas bort.
BACKUP_BEHALL=14

# ── Integrationsplattformen (valfri) ──────────────────────────────────────────
# Slå på: avkommentera COMPOSE_PROFILES och INTEGRATION_PLATFORM_URL, fyll i
# hemligheterna och  cp caddy/mallar/plattform.caddy caddy/sites/
# COMPOSE_PROFILES=plattform
# INTEGRATION_PLATFORM_URL=http://plattform-api:8000/api/v1
# Plattformens webb, utan https://.
PLATFORM_HOST=
# Krypterar sparade inloggningsuppgifter till källsystem. Byts den blir de
# oläsbara – spara den med backupen.
PLATFORM_ENCRYPTION_KEY=
# Plattformens administratörsnyckel; portalen använder den för "Hämta nu".
PLATFORM_ADMIN_API_KEY=
PLATFORM_JWT_SECRET=
PLATFORM_POSTGRES_PASSWORD=
# Delas av plattformens webhook "efter körning" och portalens synk.
SYNC_WEBHOOK_SECRET=
# Konsumentnyckeln portalen LÄSER med – skapas i plattformen.
INTEGRATION_PLATFORM_API_KEY=
EXECUTION_LOG_RETENTION_DAYS=30
ALERT_WEBHOOK_URL=

# ── Arkitekten, processritaren (valfri, kräver plattformen) ───────────────────
# Slå på med installationsguiden: profilen arkitekten i COMPOSE_PROFILES
# (COMPOSE_PROFILES=plattform,arkitekten), modulen arkitekten i MODULES,
# caddy/mallar/arkitekten.caddy i caddy/sites/ och källan i plattformen.
ARKITEKTEN_VERSION=0.3.2
# Arkitektens webb, utan https://.
ARKITEKTEN_HOST=
# Portalens länk till Arkitekten (https://<ARKITEKTEN_HOST>).
ARKITEKTEN_URL=
# Signerar sessionerna.
ARKITEKTEN_SESSION_SECRET=
# lokal (egna konton – första besöket skapar administratören) eller entra.
ARKITEKTEN_AUTH=lokal
# Entra ID: egen app-registrering, eller portalens med en Web-redirect-URI
# https://<ARKITEKTEN_HOST>/__ark/auth/callback och en klienthemlighet.
ARKITEKTEN_ENTRA_TENANT_ID=
ARKITEKTEN_ENTRA_CLIENT_ID=
ARKITEKTEN_ENTRA_CLIENT_SECRET=
ARKITEKTEN_ENTRA_ADMIN_ROLLER=Arkitekten.Admin,Admin
ARKITEKTEN_ENTRA_ADMIN_GRUPPER=
# Valfritt: AI-stödet (tomt = av).
ARKITEKTEN_ANTHROPIC_API_KEY=
# Valfritt: namnet på organisationens portalsystem och systemprocessernas samling.
ARKITEKTEN_PORTALBANA=
ARKITEKTEN_SYSTEMPROCESS_KATEGORI=
